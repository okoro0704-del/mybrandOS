# mybrandOS kernel
NODE_ENV=development
PORT=8793
HOST=0.0.0.0
COOKIE_SECRET=mybrandos-dev-cookie-secret-change-me
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:5176
# Production public URL (Railway domain). Used for CORS, Trust ID redirect, os-shell manifest.
PUBLIC_ORIGIN=
DATABASE_URL=file:./dev.db
# Optional: path to Vite build when API serves the SPA (Docker sets WEB_DIST).
WEB_DIST=

# Primitive mode: local adapters permitted in development only.
# Production requires PRIMITIVES_MODE=remote and fails closed — no silent local fallbacks.
PRIMITIVES_MODE=local

# Canonical primitive IDs (do not invent aliases as independent primitives):
# trust-id, elfcom, sovereign-drive, platform-jobs, master-distributor, fundzman

# trust-id — identity authority (OAuth/PKCE in remote/production)
TRUSTID_API=http://localhost:8787
TRUSTID_CLIENT_ID=mybrandos_public
TRUSTID_REDIRECT_URI=http://localhost:5176/auth/callback
TRUSTID_SCOPES=openid identity.basic identity.zk_claims identity.trust_level identity.verification_status

# sovereign-drive / DataZone BaaS — object storage. Production requires DATAZONE_BOUND=true + API key.
DATAZONE_API_URL=http://localhost:4200
DATAZONE_API_KEY=
DATAZONE_BOUND=false

# elfcom — messaging. Optional; unbound must stay honest (no fabricated inbox).
ELFCOM_MODE=unbound
ELFCOM_BASE_URL=http://localhost:8791
ELFCOM_NODE_SECRET=

# platform-jobs — Desktop/Platform Job. POST /v1/jobs/dispatch. Required in production.
# Do not point this at a local Redis/BullMQ inside mybrandOS.
PLATFORM_JOBS_URL=
PLATFORM_JOBS_TOKEN=

# fundzman — wallet/ledger primitive API (GET /v1/wallet/:userId/summary).
# Do NOT point this at the FundzMan Supabase product (*.supabase.co) or Lovable app.
# Optional; unbound returns connected:false and null balances.
FUNDZMAN_URL=

# master-distributor — OS/application releases, domains, SSL. NOT content distribution.
# Not the same as Platform Job apps/distribution-hub.
MASTER_DISTRIBUTOR_URL=
# Legacy alias accepted only as MASTER_DISTRIBUTOR_URL fallback:
# DISTRIBUTOR_URL=

# Large imports dispatch through Platform Jobs after DataZone persist (bytes).
LARGE_IMPORT_BYTES=8388608

# AI is a provider capability, not a seventh primitive.
AI_PROVIDER=unbound
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
