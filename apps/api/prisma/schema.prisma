generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetOrigin {
  CREATED_INTERNAL
  IMPORTED_FILE
  IMPORTED_URL
  IMPORTED_EXTERNAL
  LIVE_REPLAY
}

enum AssetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  BOOK
  COURSE
  VIDEO
  MUSIC
  SOFTWARE
  SERVICE
  PRODUCT
  MEMBERSHIP
  DOCUMENT
  DESIGN
  PODCAST
  WEBSITE
  DIGITAL_OFFER
  WRITING
  OTHER
}

enum CreateMode {
  MANUAL
  AI
  IMPORT
}

enum ProductionSourceType {
  CREATOR_LIBRARY
  DIRECT_UPLOAD
  SUPPLIED
  LICENSED
  SYNDICATED
  PUBLIC_DOMAIN
  COMMISSIONED
}
enum ProductionRightsBasis {
  OWNED
  LICENSED
  SYNDICATED
  SUPPLIED
  COMMISSIONED
  PUBLIC_DOMAIN
  OTHER
}
enum BroadcastScheduleStatus {
  DRAFT
  PUBLISHED
}

enum PostCommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum PostReactionType {
  LOVE
}

/// A public comment on a published Asset (post). One row per comment, so concurrent
/// commenters can never overwrite each other. Legacy JSON comments keep their `c_<hex>` id.
model PostComment {
  id              String            @id @default(cuid())
  assetId         String
  asset           Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Trust ID or guest interaction key (`resolveInteractionIdentity`).
  authorId        String
  displayName     String
  parentCommentId String?
  parent          PostComment?      @relation("PostCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         PostComment[]     @relation("PostCommentReplies")
  body            String
  status          PostCommentStatus @default(VISIBLE)
  createdAt       DateTime          @default(now())
  editedAt        DateTime?

  @@index([assetId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentCommentId])
}

/// One reaction per (post, actor, type). The unique key makes Love idempotent and race-safe;
/// counts are always derived from rows, never stored as an authority.
model PostReaction {
  id           String           @id @default(cuid())
  assetId      String
  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorId      String
  reactionType PostReactionType @default(LOVE)
  createdAt    DateTime         @default(now())

  @@unique([assetId, actorId, reactionType])
  @@index([assetId, reactionType])
  @@index([actorId])
}

/// Public view/play/completion counters, incremented atomically in SQL (no JSON read-modify-write).
model AssetEngagement {
  assetId     String   @id
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  views       Int      @default(0)
  plays       Int      @default(0)
  completions Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  ownerId   String
  identity  String
  /// How the session was issued: trustid | white_label | dev_bypass | dev_local | legacy (pre-method rows).
  authMethod String  @default("legacy")
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Trust ID access token, AES-256-GCM sealed and bound to this session id. Server-side only;
  /// forwarded only to Digi AI as actor proof. Never returned to the browser.
  providerAccessToken    String?
  providerTokenExpiresAt DateTime?

  @@index([ownerId])
}

model Asset {
  id            String      @id @default(cuid())
  ownerId       String
  title         String
  description   String      @default("")
  assetType     AssetType
  origin        AssetOrigin
  status        AssetStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  dataZoneId    String?
  metadata      String      @default("{}")
  relationships String      @default("[]")
  analytics     String      @default("{}")
  commerce      String      @default("{}")
  distribution  String      @default("{}")
  visibility    String      @default("private")
  originSource    String?
  originRef       String?
  sourceProjectId String?

  activity           Activity[]
  outboundRelations  AssetRelationship[] @relation("SourceAsset")
  inboundRelations   AssetRelationship[] @relation("TargetAsset")
  productionItems    ProductionLibraryItem[]
  comments           PostComment[]
  reactions          PostReaction[]
  engagement         AssetEngagement?

  @@index([ownerId])
  @@index([ownerId, assetType])
  @@index([ownerId, status])
  @@index([ownerId, origin])
  @@index([ownerId, updatedAt])
  @@index([ownerId, createdAt])
  @@index([title])
}

model Activity {
  id        String   @id @default(cuid())
  ownerId   String
  kind      String
  title     String
  detail    String   @default("")
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([assetId, createdAt])
}

model ImportJob {
  id             String   @id @default(cuid())
  ownerId        String
  method         String
  status         String   @default("completed")
  origin         AssetOrigin
  source         String?
  assetIds       String   @default("[]")
  platformJobId  String?
  jobStatus      String   @default("")
  createdAt      DateTime @default(now())

  @@index([ownerId])
  @@index([platformJobId])
}

model CreationProject {
  id                 String      @id @default(cuid())
  ownerId            String
  title              String
  description        String      @default("")
  projectType        String      @default("OTHER")
  status             String      @default("DRAFT")
  origin             AssetOrigin @default(CREATED_INTERNAL)
  assetId            String?
  mode               CreateMode  @default(MANUAL)
  publishStatus      String      @default("DRAFT")
  draftState         String      @default("{}")
  settings           String      @default("{}")
  currentVersionId   String?
  derivedFromAssetId String?
  lastAutosavedAt    DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  blocks    ContentBlock[]
  versions  ProjectVersion[]
  files     ProjectFile[]
  aiActions AiAction[]
  members   ProjectMember[]
  bookMeta      BookMetadata?
  chapters      BookChapter[]
  courseMeta    CourseMetadata?
  courseModules CourseModule[]
  videoMeta     VideoMetadata?
  scenes        VideoScene[]
  musicMeta     MusicMetadata?
  tracks        MusicTrack[]
  writingMeta   WritingMetadata?
  softwareMeta  SoftwareMetadata?
  softwareCollaborators SoftwareCollaborator[]
  softwarePermissions   SoftwareWorkspacePermission[]
  softwareSecrets       SoftwareProjectSecret[]
  softwareEvents        SoftwareProjectEvent[]
  liveSessions  LiveSession[]

  @@index([ownerId])
  @@index([ownerId, projectType])
  @@index([ownerId, status])
}

model ContentBlock {
  id        String          @id @default(cuid())
  projectId String
  project   CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  position  Int
  content   String          @default("{}")
  metadata  String          @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([projectId, position])
}

model ProjectVersion {
  id        String          @id @default(cuid())
  projectId String
  project   CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  label     String          @default("")
  snapshot  String
  isCurrent Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([projectId, number])
  @@index([projectId])
}

model ProjectFile {
  id         String          @id @default(cuid())
  projectId  String
  project    CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId    String
  dataZoneId String
  filename   String
  mimeType   String
  sizeBytes  Int             @default(0)
  metadata   String          @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([projectId])
  @@index([ownerId])
}

model AiAction {
  id         String          @id @default(cuid())
  projectId  String
  project    CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  actionType String
  input      String
  output     String          @default("")
  provider   String
  status     String          @default("completed")
  createdAt  DateTime        @default(now())

  @@index([projectId])
}

model AssetRelationship {
  id               String   @id @default(cuid())
  sourceAssetId    String
  targetAssetId    String
  relationshipType String
  createdAt        DateTime @default(now())
  source           Asset    @relation("SourceAsset", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  target           Asset    @relation("TargetAsset", fields: [targetAssetId], references: [id], onDelete: Cascade)

  @@unique([sourceAssetId, targetAssetId, relationshipType])
  @@index([sourceAssetId])
  @@index([targetAssetId])
}

model ProductionLibraryItem {
  id String @id @default(cuid())
  ownerId String
  assetId String
  asset Asset @relation(fields:[assetId], references:[id], onDelete: Restrict)
  sourceType ProductionSourceType
  rightsBasis ProductionRightsBasis
  rightsReference String?
  validFrom DateTime?
  validUntil DateTime?
  territory String?
  allowedChannels String @default("[]")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  programs BroadcastProgram[]
  @@unique([ownerId, assetId])
  @@index([ownerId])
}

model BroadcastProgram {
  id String @id @default(cuid())
  ownerId String
  channelId String
  productionItemId String
  productionItem ProductionLibraryItem @relation(fields:[productionItemId], references:[id], onDelete: Restrict)
  assetId String
  title String
  durationMs Int?
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries BroadcastScheduleEntry[]
  @@index([ownerId, channelId])
}

model BroadcastSchedule {
  id String @id @default(cuid())
  ownerId String
  channelId String
  scheduleId String
  version Int
  status BroadcastScheduleStatus
  startsAt DateTime
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries BroadcastScheduleEntry[]
  @@unique([ownerId, scheduleId, version])
  @@index([ownerId, channelId, status])
}

model BroadcastScheduleEntry {
  id String @id @default(cuid())
  scheduleId String
  schedule BroadcastSchedule @relation(fields:[scheduleId], references:[id], onDelete: Cascade)
  programId String
  program BroadcastProgram @relation(fields:[programId], references:[id], onDelete: Restrict)
  sequence Int
  startsAt DateTime
  endsAt DateTime
  @@unique([scheduleId, sequence])
}

model BroadcastSpaceSync {
  id String @id @default(cuid())
  ownerId String
  channelId String
  spaceScheduleVersion Int?
  mediaReadyCount Int @default(0)
  mediaRequiredCount Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([ownerId, channelId])
}

model ProjectMember {
  id        String          @id @default(cuid())
  projectId String
  project   CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  role      String
  createdAt DateTime        @default(now())

  @@unique([projectId, userId])
}

model DistributionIntent {
  id        String   @id @default(cuid())
  ownerId   String
  projectId String
  assetId   String?
  mode      String
  status    String   @default("recorded")
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([projectId])
}

model PersonalSpace {
  id                String   @id @default(cuid())
  ownerId           String   @unique
  displayName       String   @default("")
  headline          String   @default("")
  bio               String   @default("")
  links             String   @default("[]")
  featuredAssetIds  String   @default("[]")
  slug              String?  @unique
  publicEnabled     Boolean  @default(false)
  theme             String   @default("{}")
  publicNav         String   @default("[]")
  cta               String   @default("{}")
  brandMedia        String   @default("{}")
  websitePages      String   @default("[]")
  presentationConfig String @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AudienceSegment {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model BookMetadata {
  id          String          @id @default(cuid())
  projectId   String          @unique
  project     CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtitle    String          @default("")
  authorName  String          @default("")
  language    String          @default("")
  genre       String          @default("")
  description String          @default("")
  isbn        String          @default("")
  edition     String          @default("")
  publisher   String          @default("")
  copyright   String          @default("")
  coverFileId String?
  extra       String          @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model BookChapter {
  id        String          @id @default(cuid())
  projectId String
  project   CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  slug      String          @default("")
  position  Int
  status    String          @default("DRAFT")
  kind      String          @default("CHAPTER")
  matterType String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sections  BookSection[]

  @@index([projectId, position])
}

model BookSection {
  id        String      @id @default(cuid())
  chapterId String
  chapter   BookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([chapterId, position])
}

model CourseMetadata {
  id               String          @id @default(cuid())
  projectId        String          @unique
  project          CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtitle         String          @default("")
  description      String          @default("")
  instructorName   String          @default("")
  language         String          @default("")
  level            String          @default("")
  category         String          @default("")
  estimatedDuration String         @default("")
  thumbnailFileId  String?
  extra            String          @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CourseModule {
  id          String          @id @default(cuid())
  projectId   String
  project     CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  position    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lessons     CourseLesson[]

  @@index([projectId, position])
}

model CourseLesson {
  id              String       @id @default(cuid())
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String       @default("")
  position        Int
  lessonType      String       @default("TEXT")
  status          String       @default("DRAFT")
  durationSeconds Int?
  thumbnailFileId String?
  extra           String       @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questions       CourseQuizQuestion[]

  @@index([moduleId, position])
}

model CourseQuizQuestion {
  id              String       @id @default(cuid())
  lessonId        String
  lesson          CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt          String
  questionType    String
  answers         String       @default("[]")
  correctAnswerId String       @default("")
  explanation     String       @default("")
  position        Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([lessonId, position])
}

model VideoMetadata {
  id                 String          @id @default(cuid())
  projectId          String          @unique
  project            CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description        String          @default("")
  aspectRatio        String          @default("16:9")
  frameRate          String          @default("")
  durationMs         Int?
  sourceFileId       String?
  thumbnailFileId    String?
  audioFileId        String?
  captionFileId      String?
  renderOutputFileId String?
  extra              String          @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model VideoScene {
  id          String          @id @default(cuid())
  projectId   String
  project     CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  text        String          @default("")
  position    Int
  durationMs  Int?
  mediaFileId String?
  extra       String          @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, position])
}

model LiveSession {
  id               String           @id @default(cuid())
  ownerId          String
  projectId        String?
  project          CreationProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceAssetId    String?
  title            String
  description      String           @default("")
  status           String           @default("SCHEDULED")
  visibility       String           @default("private")
  startedAt        DateTime?
  endedAt          DateTime?
  replayAssetId    String?
  replayProjectId  String?
  finalizeJobId    String?
  notification     String           @default("idle")
  broadcastId      String?
  detail           String           @default("")
  extra            String           @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  distributions    LiveDistributionIntent[]

  @@index([ownerId, status])
  @@index([status, visibility])
  @@index([projectId])
}

model LiveDistributionIntent {
  id                 String      @id @default(cuid())
  liveSessionId      String
  liveSession        LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  destination        String
  status             String      @default("SELECTED")
  externalReference  String?
  startedAt          DateTime?
  endedAt            DateTime?
  errorCode          String?
  errorMessage       String?
  retryable          Boolean     @default(false)
  metadata           String      @default("{}")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([liveSessionId, destination])
  @@index([liveSessionId])
  @@index([destination, status])
}

model MusicMetadata {
  id             String          @id @default(cuid())
  projectId      String          @unique
  project        CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artistName     String          @default("")
  description    String          @default("")
  genre          String          @default("")
  subgenre       String          @default("")
  releaseDate    String          @default("")
  durationMs     Int?
  coverFileId    String?
  audioFileId    String?
  lyricsFileId   String?
  explicit       Boolean         @default(false)
  collectionKind String          @default("SINGLE")
  extra          String          @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MusicTrack {
  id          String          @id @default(cuid())
  projectId   String
  project     CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  artistName  String          @default("")
  genre       String          @default("")
  description String          @default("")
  lyrics      String          @default("")
  coverFileId String?
  audioFileId String?
  lyricsFileId String?
  explicit    Boolean         @default(false)
  durationMs  Int?
  position    Int
  extra       String          @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, position])
}

model WritingMetadata {
  id          String          @id @default(cuid())
  projectId   String          @unique
  project     CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtitle    String          @default("")
  authorName  String          @default("")
  description String          @default("")
  language    String          @default("")
  genre       String          @default("")
  form        String          @default("ARTICLE")
  extra       String          @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SoftwareMetadata {
  id                  String          @id @default(cuid())
  projectId           String          @unique
  project             CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version             String          @default("0.1.0")
  description         String          @default("")
  developer           String          @default("")
  license             String          @default("")
  repositoryUrl       String          @default("")
  documentationUrl    String          @default("")
  websiteUrl          String          @default("")
  platforms           String          @default("[]")
  publicPackageFileId String?
  extra               String          @default("{}")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model SoftwareCollaborator {
  id         String          @id @default(cuid())
  projectId  String
  project    CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  role       String          @default("DEVELOPER")
  status     String          @default("INVITED")
  invitedAt  DateTime        @default(now())
  acceptedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([projectId, userId])
  @@index([userId, status])
}

model SoftwareWorkspacePermission {
  id         String          @id @default(cuid())
  projectId  String
  project    CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  permission String
  scope      String          @default("PROJECT")
  scopeRef   String          @default("")
  createdAt  DateTime        @default(now())

  @@unique([projectId, userId, permission, scope, scopeRef])
  @@index([projectId, userId])
}

model SoftwareProjectSecret {
  id               String          @id @default(cuid())
  projectId        String
  project          CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  valueCipher      String          @default("")
  availableToExec  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([projectId, name])
}

model SoftwareProjectEvent {
  id        String          @id @default(cuid())
  projectId String
  project   CreationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  kind      String
  title     String
  detail    String          @default("")
  createdAt DateTime        @default(now())

  @@index([projectId, createdAt])
}

model CommerceItem {
  id              String   @id @default(cuid())
  ownerId         String
  kind            String
  title           String
  status          String   @default("DRAFT")
  assetId         String?
  description     String   @default("")
  price           Int      @default(0)
  currency        String   @default("NGN")
  fulfillmentType String   @default("")
  availability    String   @default("UNAVAILABLE")
  extra           String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  checkouts     CommerceCheckout[]
  orders        CommerceOrder[]
  entitlements  CommerceEntitlement[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([assetId])
}

model CommerceCheckout {
  id              String   @id @default(cuid())
  offerId         String
  offer           CommerceItem @relation(fields: [offerId], references: [id], onDelete: Cascade)
  ownerId         String
  buyerId         String
  idempotencyKey  String
  state           String   @default("CREATED")
  amount          Int      @default(0)
  currency        String   @default("NGN")
  fundzmanRef     String   @default("")
  failureReason   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  order           CommerceOrder?

  @@unique([buyerId, idempotencyKey])
  @@index([offerId])
  @@index([ownerId])
  @@index([buyerId])
}

model CommerceOrder {
  id                String   @id @default(cuid())
  checkoutId        String   @unique
  checkout          CommerceCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  offerId           String
  offer             CommerceItem @relation(fields: [offerId], references: [id], onDelete: Cascade)
  ownerId           String
  buyerId           String
  paymentState      String
  fulfillmentState  String   @default("PENDING")
  amount            Int      @default(0)
  currency          String   @default("NGN")
  fundzmanRef       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  entitlement       CommerceEntitlement?

  @@index([ownerId])
  @@index([buyerId])
  @@index([offerId])
}

model CommerceEntitlement {
  id               String   @id @default(cuid())
  orderId          String   @unique
  order            CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offerId          String
  offer            CommerceItem @relation(fields: [offerId], references: [id], onDelete: Cascade)
  assetId          String
  buyerId          String
  ownerId          String
  status           String   @default("ACTIVE")
  fulfillmentType  String   @default("")
  createdAt        DateTime @default(now())
  revokedAt        DateTime?

  @@index([buyerId])
  @@index([assetId])
  @@index([ownerId])
}

model ProductionSession {
  id            String   @id @default(cuid())
  ownerId       String
  title         String
  status        String   @default("DRAFT")
  scene         String   @default("CREATOR")
  projectId     String?
  assetId       String?
  liveSessionId String?
  detail        String   @default("")
  extra         String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  devices       ProductionDevice[]
  sources       ProductionSource[]
  pairings      ProductionPairing[]

  @@index([ownerId, status])
  @@index([liveSessionId])
}

model ProductionDevice {
  id           String    @id @default(cuid())
  sessionId    String
  session      ProductionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ownerId      String
  label        String
  kind         String
  role         String    @default("")
  status       String    @default("PENDING")
  capabilities String    @default("{}")
  tokenHash    String    @default("")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  sources      ProductionSource[]

  @@index([sessionId])
  @@index([ownerId])
  @@index([tokenHash])
}

model ProductionSource {
  id        String   @id @default(cuid())
  sessionId String
  session   ProductionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String
  label     String
  selected  Boolean  @default(false)
  available Boolean  @default(false)
  detail    String   @default("")
  deviceId  String?
  device    ProductionDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  projectId String?
  assetId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([sessionId])
}

model ProductionPairing {
  id         String    @id @default(cuid())
  sessionId  String
  session    ProductionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ownerId    String
  code       String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  deviceId   String?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([ownerId])
}

/// Application-domain Recording Session — not an Asset, not a primitive.
model RecordingSession {
  id                   String   @id @default(cuid())
  ownerId              String
  title                String
  mode                 String   @default("VIDEO")
  status               String   @default("DRAFT")
  productionSessionId  String?
  projectId            String?
  assetId              String?
  audioEnabled         Boolean  @default(true)
  scene                String   @default("CREATOR")
  detail               String   @default("")
  programMediaZoneId   String?
  programMediaMime     String   @default("")
  finalizeJobId        String?
  extra                String   @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  tracks               RecordingTrack[]
  takes                RecordingTake[]
  program              ProgramOutput?
  previews             PreviewSession[]

  @@index([ownerId, status])
  @@index([productionSessionId])
  @@index([projectId])
}

model RecordingTrack {
  id             String   @id @default(cuid())
  sessionId      String
  session        RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           String
  name           String
  sourceKind     String   @default("")
  deviceId       String?
  position       Int      @default(0)
  volume         Float    @default(1)
  mute           Boolean  @default(false)
  solo           Boolean  @default(false)
  status         String   @default("EMPTY")
  beatAssetId    String?
  sourceAssetId  String?
  selectedTakeId String?
  spatialJson    String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  takes          RecordingTake[]

  @@index([sessionId])
}

model RecordingTake {
  id          String   @id @default(cuid())
  trackId     String
  track       RecordingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sessionId   String
  session     RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      String   @default("READY")
  startTime   DateTime?
  durationMs  Int?
  dataZoneId  String?
  mimeType    String   @default("")
  byteSize    Int?
  createdBy   String
  detail      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([trackId])
  @@index([sessionId])
  @@index([dataZoneId])
}

model ProgramOutput {
  id                   String   @id @default(cuid())
  sessionId            String   @unique
  session              RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  state                String   @default("IDLE")
  scene                String   @default("CREATOR")
  activeVideoSourceId  String?
  activeAudioSourceIds String   @default("[]")
  layout               String   @default("single")
  detail               String   @default("")
  updatedAt            DateTime @default(now()) @updatedAt
  createdAt            DateTime @default(now())
}

/// Scoped, revocable external preview — not an owner session.
model PreviewSession {
  id                   String    @id @default(cuid())
  ownerId              String
  recordingSessionId   String?
  recordingSession     RecordingSession? @relation(fields: [recordingSessionId], references: [id], onDelete: Cascade)
  productionSessionId  String?
  code                 String    @unique
  tokenHash            String
  kind                 String    @default("PROGRAM")
  status               String    @default("PREVIEW_READY")
  expiresAt            DateTime
  revokedAt            DateTime?
  detail               String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([ownerId])
  @@index([recordingSessionId])
  @@index([tokenHash])
}

model DigiAiDraftIdempotency {
  id             String   @id @default(cuid())
  ownerId        String
  idempotencyKey String
  payloadDigest  String
  assetId        String
  createdAt      DateTime @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([assetId])
}

model DigiAiPublishIdempotency {
  id               String    @id @default(cuid())
  ownerId          String
  idempotencyKey   String
  payloadDigest    String
  assetId          String
  authorizationRef String
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([assetId])
}

/// Digi Twin delegation: an authenticated creator lets their Twin perform named actions in their
/// own Space for a short time. The Twin is not a Trust ID subject and holds no authority of its own.
model TwinDelegation {
  id           String    @id @default(cuid())
  /// Canonical Trust ID subject of the human who granted it.
  humanSubject String
  /// Creator account (mybrandOS ownerId).
  ownerId      String
  /// Creator-owned Space (PersonalSpace.id).
  spaceId      String
  twinId       String
  /// JSON array of registered Twin capabilities.
  capabilities String
  /// mybrandOS session that granted it.
  sessionId    String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  approvals    TwinApproval[]

  @@index([ownerId, createdAt])
}

/// Single-use human approval for one sensitive Twin action on one exact target and payload.
model TwinApproval {
  id            String         @id @default(cuid())
  delegationId  String
  delegation    TwinDelegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  humanSubject  String
  ownerId       String
  spaceId       String
  action        String
  targetId      String
  payloadDigest String
  /// sha256 of the one-time approval secret given to the approving human.
  tokenHash     String         @unique
  sessionId     String
  expiresAt     DateTime
  consumedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([ownerId, createdAt])
}

/// Idempotency for Twin actions: one execution per delegation and idempotency key.
model TwinActionExecution {
  id             String   @id @default(cuid())
  delegationId   String
  ownerId        String
  action         String
  idempotencyKey String
  payloadDigest  String
  status         String
  resultId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([delegationId, idempotencyKey])
  @@index([ownerId, createdAt])
}

/// Audit trail for Twin delegation, approval and action outcomes.
model TwinAuditEvent {
  id            String   @id @default(cuid())
  correlationId String
  ownerId       String
  humanSubject  String
  /// "human:<subject>" or "twin:<twinId>"
  actor         String
  delegationId  String?
  approvalId    String?
  action        String
  targetId      String?
  /// ALLOWED | DENIED | SUCCEEDED | FAILED
  outcome       String
  reason        String   @default("")
  createdAt     DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([correlationId])
}
